# ExpenseReconciler — environment variable reference (O3)
#
# This file documents every env var app/config.py's Settings model
# requires. It contains NO real values or plausible-looking fake
# secrets — only placeholder text — and is meant to be copied to
# `.env` for local development (never commit `.env` itself; it's
# already covered by .gitignore-style local-only convention) or used
# as the checklist when filling in Render's environment variable
# dashboard for production. See app/config.py for the authoritative
# field list; keep this file in sync with it going forward.
#
# In production (Render), none of these are set via this file — they
# are entered directly in Render's dashboard as service environment
# variables (see render.yaml, and the O1a infra-note in
# docs/agent-artifacts/devops/2026-09-27-render-neon-deploy-config.md).

# --- App ---------------------------------------------------------------

# "development" or "production". Defaults to "development" if unset,
# so this line is optional for local dev; Render sets it to
# "production" explicitly (see render.yaml). Verification/session and
# protected Plaid requests require HTTPS in production; development
# permits HTTP only on localhost, 127.0.0.1, or ::1.
ENVIRONMENT=development

# --- Database (Neon Postgres in production, local Postgres in dev) -----

# SQLAlchemy async connection string. app/config.py normalizes a plain
# postgresql:// / postgres:// scheme to postgresql+asyncpg:// for you,
# so you can paste Neon's connection string mostly as-is — EXCEPT see
# the known asyncpg/sslmode caveat documented in the O1a infra-note
# (docs/agent-artifacts/devops/2026-09-27-render-neon-deploy-config.md)
# before using a Neon connection string as-is.
# Local dev: your own local Postgres instance.
# Production: Neon project dashboard -> Connection Details -> Connection string.
DATABASE_URL=postgresql://your-db-user:your-db-password@localhost:5432/expense_reconciler

# --- Plaid (bank data) --------------------------------------------------

# Plaid dashboard -> Team Settings -> Keys.
PLAID_CLIENT_ID=your-plaid-client-id-here
PLAID_SECRET=your-plaid-secret-here

# "sandbox" or "production". Defaults to "sandbox" if unset — matches
# whichever Plaid secret above you're using (sandbox vs. production
# secrets are different values in the Plaid dashboard).
PLAID_ENV=sandbox

# --- Telegram bot --------------------------------------------------------

# From @BotFather after creating the bot (Telegram -> message
# @BotFather -> /newbot, or /token for an existing bot).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Your own Telegram numeric chat ID — the app only responds to this
# chat (personal-use allowlist). Get it by messaging @userinfobot or
# similar, or by inspecting an update from your bot before this
# allowlist is enforced.
TELEGRAM_ALLOWED_CHAT_ID=your-telegram-chat-id-here

# A secret string you choose yourself (e.g. `openssl rand -hex 32`)
# and register with Telegram's setWebhook call as secret_token; the
# app checks incoming webhook requests carry this same value in the
# X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET_TOKEN=<set-your-own-random-secret-here>

# --- Jarvis verification / account-linking -------------------------------

# Jarvis access details you choose yourself, entered in the public
# /link-account form. Successful verification creates a signed
# 15-minute browser session protecting the Plaid linking endpoints.
# These are not bank credentials; bank credentials are entered in Plaid.
ADMIN_USERNAME=<choose-your-own-admin-username>
ADMIN_PASSWORD=<choose-your-own-admin-password>

# --- Token encryption and browser-session signing -----------------------

# Encrypts Plaid access tokens at rest via Postgres pgcrypto
# (pgp_sym_encrypt/pgp_sym_decrypt). Also derives a domain-separated
# session-signing key bound to the current admin credentials; no
# separate signing secret is needed. Generate a strong key once with:
#   openssl rand -base64 32
# Store it only in Render's dashboard / your local .env — never in
# git. Losing/rotating this key makes previously-encrypted tokens
# unreadable, so treat it like any other long-lived secret. Changing
# this key or the admin credentials invalidates existing browser
# sessions once the application reloads its settings.
TOKEN_ENCRYPTION_KEY=<generate-with-openssl-rand--base64-32>

# --- Weekly digest job trigger (external cron, no in-process scheduler) --

# Shared secret the external cron-job.org pinger presents as a
# Bearer token (Authorization: Bearer <this value>) when it calls
# POST /jobs/weekly-digest/trigger. Choose your own random string,
# e.g. `openssl rand -hex 32`. Distinct from Jarvis verification above —
# this is machine-to-machine, not a browser login.
JOBS_TRIGGER_SECRET=<generate-with-openssl-rand--hex-32>

# --- AI providers --------------------------------------------------------

# OpenAI platform dashboard -> API keys.
OPENAI_API_KEY=your-openai-api-key-here

# Google AI Studio (or Google Cloud console, depending on how the
# Gemini API key was provisioned) -> API keys.
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
